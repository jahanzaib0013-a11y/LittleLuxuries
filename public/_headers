# Cloudflare Pages headers
# Hashed build assets are immutable — cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static images/fonts shipped in /public
/*.webp
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
