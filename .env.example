# Redis Configuration
# Get this from https://console.upstash.com
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:your_password@your_host.upstash.io:12345

# Cloudflare R2 Configuration
# Account ID: found in Cloudflare dashboard bottom left
R2_ACCOUNT_ID=your_account_id

# R2 API Credentials
# Get from Cloudflare R2 Settings → API Credentials
R2_ACCESS_KEY_ID=cfk_xxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=your_secret_key_here

# R2 Bucket name (the bucket you created)
R2_BUCKET_NAME=little-luxuries-products

# Optional: If you set up a custom domain for R2
# Otherwise leave empty and it will use: https://{ACCOUNT_ID}.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Supabase Configuration (existing)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_key

# Cloudflare API Token (for analytics, monitoring)
CLOUDFLARE_API_TOKEN=cfut_xxxxxxxxxxxxx
