# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email (server-side via Resend — order updates, contact form, newsletter, forgot-password)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Verified sender. In production use an address on a domain you've verified in Resend.
# For quick testing you may use: Little Luxuries <onboarding@resend.dev>
RESEND_FROM="Little Luxuries <orders@yourdomain.com>"
# Optional: legacy alias also accepted as the From address if RESEND_FROM is unset
# EMAIL_FROM="Little Luxuries <orders@yourdomain.com>"
# Optional: public URL of the logo shown in email headers (Resend can't inline images)
=https://yourdomain.com/logo.png

# Manus AI publishing
# Server-only — DO NOT prefix with VITE_ (would expose to the browser bundle).
# Create at: Manus webapp -> API Integration -> Create API Key
MANUS_API_KEY=your_manus_api_key

# Connector UUIDs from GET https://api.manus.ai/v2/connector.list
# Authorize each platform in the Manus webapp first, then copy the id here.
MANUS_IG_CONNECTOR_ID=your_instagram_connector_uuid
# Optional — leave blank to disable Facebook publishing.
MANUS_FB_CONNECTOR_ID=

# Instagram Stories (Launch Sequence / Post Studio): same connector as feed.
# Use publishViaManus with placement "story" — no extra env vars.

# Enable Facebook auto-publish in publish-product-modal.
VITE_MANUS_FB_ENABLED=false

# Scheduled publisher cron secret
# Used to authenticate calls to runScheduledPublisher. Generate with:
#   openssl rand -hex 32
CRON_SECRET=your_random_secret

# For the scheduled publisher, the server needs Supabase credentials.
# Either reuse the VITE_SUPABASE_* values above, or set service-role keys here:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL for password-reset links in email (no trailing slash)
APP_URL=http://localhost:8080

# Admin account (server verifies login; VITE_* optional for legacy tooling only)
ADMIN_EMAIL=your_admin_email
# Initial password — hashed on first login/reset; update via reset link after deploy
ADMIN_PASSWORD=your_admin_password

# Optional legacy client env (not used for login after server-side auth)
VITE_ADMIN_EMAIL=your_admin_email
VITE_ADMIN_PASSWORD=your_admin_password
