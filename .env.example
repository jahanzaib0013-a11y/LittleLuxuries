# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email (server-side, used by contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password

# Manus AI publishing
# Server-only — DO NOT prefix with VITE_ (would expose to the browser bundle).
# Create at: Manus webapp -> API Integration -> Create API Key
MANUS_API_KEY=your_manus_api_key

# Connector UUIDs from GET https://api.manus.ai/v2/connector.list
# Authorize each platform in the Manus webapp first, then copy the id here.
MANUS_IG_CONNECTOR_ID=your_instagram_connector_uuid
# Optional — leave blank to disable Facebook publishing.
MANUS_FB_CONNECTOR_ID=

# Instagram Stories (Launch Sequence / Post Studio): same connector as feed.
# Use publishViaManus with placement "story" — no extra env vars.

# Enable Facebook auto-publish in publish-product-modal.
VITE_MANUS_FB_ENABLED=false

# Scheduled publisher cron secret
# Used to authenticate calls to runScheduledPublisher. Generate with:
#   openssl rand -hex 32
CRON_SECRET=your_random_secret

# For the scheduled publisher, the server needs Supabase credentials.
# Either reuse the VITE_SUPABASE_* values above, or set service-role keys here:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
